# ---- AI 智慧判讀 (選用) ----
# 留空則自動使用「規則式 fallback」，不需任何金鑰即可運作。
# 接 LLM 時填入以下三項（支援 OpenAI / Azure / Gemini 相容端點 / 本地 Ollama）。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_TIMEOUT=30

# 範例：Google Gemini（OpenAI 相容端點）
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
#
# 範例：本地 Ollama（免金鑰）
# AI_API_KEY=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# ---- 既有設定 (選用) ----
# SIGNAL_DATA_BASE=
# GOOGLE_MAPS_KEY=
# TGOS_APP_ID=
# TGOS_API_KEY=
# PORT=5000
